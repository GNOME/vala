static gboolean
test_dbus_interface_set_property (GDBusConnection* connection,
                                  const gchar* sender,
                                  const gchar* object_path,
                                  const gchar* interface_name,
                                  const gchar* property_name,
                                  GVariant* value,
                                  GError** error,
                                  gpointer user_data)
{
	gpointer* data;
	gpointer object;
	data = user_data;
	object = data[0];
	if (strcmp (property_name, "TestProperty") == 0) {
		_dbus_test_set_test_property (object, value);
		return TRUE;
	} else if (strcmp (property_name, "TestIntProperty") == 0) {
		_dbus_test_set_test_int_property (object, value);
		return TRUE;
	}
	return FALSE;
}

static void
_test_emit_properties_changed (Test * self,
                               gpointer * data,
                               guint n_pspecs,
                               GParamSpec ** pspecs)
{
	guint i;
	gboolean has_changes = FALSE;
	GVariantBuilder changed_builder;
	GVariantBuilder invalidated_builder;
	g_variant_builder_init (&changed_builder, G_VARIANT_TYPE_VARDICT);
	g_variant_builder_init (&invalidated_builder, G_VARIANT_TYPE_STRING_ARRAY);
	for (i = 0; i < n_pspecs; i++) {
		if (g_strcmp0 (pspecs[i]->name, "test-property") == 0) {
			g_variant_builder_add (&changed_builder, "{sv}", "TestProperty", _dbus_test_get_test_property (self));
			has_changes = TRUE;
		}
	}
	if (has_changes) {
		g_dbus_connection_emit_signal ((GDBusConnection *) data[1], NULL, (const gchar *) data[2], "org.freedesktop.DBus.Properties", "PropertiesChanged", g_variant_new ("(sa{sv}as)", "org.example.Test", &changed_builder, &invalidated_builder), NULL);
	} else {
		g_variant_builder_clear (&changed_builder);
		g_variant_builder_clear (&invalidated_builder);
	}
}

static void
_test_notify (GObject * gobject,
              GParamSpec * pspec,
              gpointer user_data)
{
	_test_emit_properties_changed (TEST (gobject), user_data, 1, &pspec);
}

guint
test_register_object (gpointer object,
                      GDBusConnection* connection,
                      const gchar* path,
                      GError** error)
{
	guint result;
	gpointer *data;
	data = g_new (gpointer, 3);
	data[0] = g_object_ref (object);
	data[1] = g_object_ref (connection);
	data[2] = g_strdup (path);
	result = g_dbus_connection_register_object (connection, path, (GDBusInterfaceInfo *) (&_test_dbus_interface_info), &_test_dbus_interface_vtable, data, _test_unregister_object, error);
	if (!result) {
		return 0;
	}
	g_signal_connect (object, "notify", (GCallback) _test_notify, data);
	return result;
}

static void
_test_unregister_object (gpointer user_data)
{
	gpointer* data;
	data = user_data;
	g_signal_handlers_disconnect_by_func (data[0], _test_notify, data);
	g_object_unref (data[0]);
	g_object_unref (data[1]);
	g_free (data[2]);
	g_free (data);
}

