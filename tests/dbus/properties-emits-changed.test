Packages: gio-2.0
D-Bus

Program: client

[DBus (name = "org.example.Test")]
interface Test : Object {
	[DBus (emits_changed_signal = "false")]
	public abstract int not_emitted { get; set; }
}

void main () {
	var conn = Bus.get_sync (BusType.SESSION);
	Test proxy = conn.get_proxy_sync ("org.example.Test", "/org/example/test");
	assert (proxy.not_emitted == 0);
	var main_loop = new MainLoop ();
	bool received = false;

	conn.signal_subscribe ("org.example.Test", "org.freedesktop.DBus.Properties", "PropertiesChanged", "/org/example/test", null, DBusSignalFlags.NONE, (c, sender, path, iface, signal_name, parameters) => {
		assert ((string) parameters.get_child_value (0) == "org.example.Test");

		var changed = parameters.get_child_value (1);
		assert (changed.n_children () == 1);
		assert (changed.lookup_value ("Normal", VariantType.INT32).get_int32 () == 2);

		var invalidated = parameters.get_child_value (2);
		assert (invalidated.n_children () == 1);
		assert (invalidated.get_child_value (0).get_string () == "Invalidated");

		received = true;
		main_loop.quit ();
	});

	conn.call_sync ("org.example.Test", "/org/example/test", "org.example.Test", "ChangeEverything", null, null, DBusCallFlags.NONE, -1);
	main_loop.run ();
	assert (received);
	assert (proxy.not_emitted == 4);

	var reply = conn.call_sync ("org.example.Test", "/org/example/test", "org.freedesktop.DBus.Introspectable", "Introspect", null, null, DBusCallFlags.NONE, -1);
	var xml = (string) reply.get_child_value (0);
	assert ("org.freedesktop.DBus.Property.EmitsChangedSignal\" value=\"invalidates\"" in xml);
	assert ("org.freedesktop.DBus.Property.EmitsChangedSignal\" value=\"false\"" in xml);
	assert ("org.freedesktop.DBus.Property.EmitsChangedSignal\" value=\"const\"" in xml);
}

Program: server

[DBus (name = "org.example.Test")]
class Test : Object {
	public int normal { get; set; }

	[DBus (emits_changed_signal = "invalidates")]
	public int invalidated { get; set; }

	[DBus (emits_changed_signal = "false")]
	public int not_emitted { get; set; }

	[DBus (emits_changed_signal = "const")]
	public int constant { get; construct; default = 42; }

	public void change_everything () throws GLib.Error {
		freeze_notify ();
		normal = 2;
		invalidated = 3;
		not_emitted = 4;
		thaw_notify ();
	}
}

MainLoop main_loop;

void client_exit (Pid pid, int status) {
	assert (status == 0);
	main_loop.quit ();
}

void main () {
	var conn = Bus.get_sync (BusType.SESSION);
	conn.register_object ("/org/example/test", new Test ());

	var request_result = conn.call_sync ("org.freedesktop.DBus", "/org/freedesktop/DBus", "org.freedesktop.DBus", "RequestName",
	                                      new Variant ("(su)", "org.example.Test", 0x4), null, 0, -1);
	assert ((uint) request_result.get_child_value (0) == 1);

	Pid client_pid;
	Process.spawn_async (null, { "dbus_properties_emits_changed_client" }, null, SpawnFlags.DO_NOT_REAP_CHILD, null, out client_pid);
	ChildWatch.add (client_pid, client_exit);

	main_loop = new MainLoop ();
	main_loop.run ();
}
